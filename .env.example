# Notion integration token — get one at https://www.notion.so/profile/integrations
NOTION_TOKEN=your_notion_integration_token_here

# Database ID of your LinkedIn Comment Queue DB (the 32-char string in the DB URL,
# https://www.notion.so/<DB_ID>?v=...)
NOTION_DB_ID=your_notion_database_id_here

# Optional: override default Chrome profile location (~/.linkedin-commenter/chrome-profile)
# CHROME_PROFILE_DIR=/custom/path

# Optional: pipe-separated list of authors to auto-archive when running approve-and-archive
# Example: ARCHIVE_AUTHORS="John Doe|Jane Smith|spammer123"
# ARCHIVE_AUTHORS=

# Kill switch — set to 1 to halt all scan/publish operations
LINKEDIN_PAUSE=0

# Dry run — log what would happen without scraping or publishing
DRY_RUN=0
