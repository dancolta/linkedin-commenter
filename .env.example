# Notion integration token — get one at https://www.notion.so/profile/integrations
NOTION_TOKEN=your_notion_integration_token_here

# Database ID of your LinkedIn Comment Queue DB (the 32-char string in the DB URL,
# https://www.notion.so/<DB_ID>?v=...)
NOTION_DB_ID=your_notion_database_id_here

# Optional: override default Chrome profile location (~/.linkedin-commenter/chrome-profile)
# CHROME_PROFILE_DIR=/custom/path

# Optional: pipe-separated list of authors to auto-archive when running approve-and-archive
# Example: ARCHIVE_AUTHORS="John Doe|Jane Smith|spammer123"
# ARCHIVE_AUTHORS=

# === Targeting filters (all optional, all case-insensitive substring match) ===
# ONLY_AUTHORS — if set, ONLY draft for posts from these authors (positive filter).
#                Pipe-separated. Substring match against author name.
# Example: ONLY_AUTHORS="Lenny Rachitsky|April Dunford|Pieter Levels"
# ONLY_AUTHORS=

# SKIP_AUTHORS — never draft for posts from these authors (negative filter).
#                Same format as ONLY_AUTHORS. Skip applies before any drafting/Claude call.
# Example: SKIP_AUTHORS="hustle bro|crypto guru|inspirational quote bot"
# SKIP_AUTHORS=

# ONLY_KEYWORDS — if set, ONLY draft for posts whose text contains at least one of these.
#                 Pipe-separated. Use to focus on topics that match your wheelhouse.
# Example: ONLY_KEYWORDS="b2b saas|gtm|founder-led sales|pricing|onboarding"
# ONLY_KEYWORDS=

# SKIP_KEYWORDS — skip posts whose text contains any of these.
#                 Use to filter out engagement-bait + topics you don't want to touch.
# Example: SKIP_KEYWORDS="hot take|grateful to announce|game-changer|crypto|nft"
# SKIP_KEYWORDS=

# Kill switch — set to 1 to halt all scan/publish operations
LINKEDIN_PAUSE=0

# Dry run — log what would happen without scraping or publishing
DRY_RUN=0

# Headed browser — set to 1 to watch the Chromium window during scan/publish
# (default: headless, no window). `setup` always runs headed regardless.
# LINKEDIN_HEADED=0
